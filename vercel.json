{
  "functions": {
    "api/index.ts": {
      "includeFiles": "Base/templates/**"
    }
  },
  "routes": [
    {
      "src": "/(robots\\.txt|sitemap\\.xml|llms\\.txt)",
      "dest": "/static/seo/$1"
    },
    {
      "src": "/repos.json",
      "dest": "/repos.json"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/project_details(\\.html)?/?",
      "dest": "/project_details.html"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ]
}
